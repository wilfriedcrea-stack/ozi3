<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Route direct /oeuvre/<slug> or ?oeuvre=<slug> for social bots to share.php
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Meta-ExternalAgent|Twitterbot|WhatsApp|LinkedInBot|Discordbot|Slackbot|TelegramBot|Pinterest) [NC]
  RewriteCond %{QUERY_STRING} (^|&)oeuvre=([^&]+) [NC]
  RewriteRule ^$ /share.php [L,QSA]

  RewriteRule ^oeuvre/([a-zA-Z0-9_-]+)/?$ /share.php?oeuvre=$1 [L,QSA]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Activation de la compression GZIP pour la rapidité
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# Mise en cache des assets statiques (images, polices, css, js)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/truetype "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
