{
  "entities": {
    "Series": {
      "title": "Series",
      "description": "Oeuvre de bande dessinée, webtoon ou manga",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "author": { "type": "string" },
        "artist": { "type": "string" },
        "country": { "type": "string" },
        "synopsis": { "type": "string" },
        "genre": { "type": "string" },
        "coverUrl": { "type": "string" },
        "bannerUrl": { "type": "string" },
        "status": { "type": "string" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "totalReads": { "type": "number" },
        "totalLikes": { "type": "number" },
        "chaptersCount": { "type": "number" },
        "isFeatured": { "type": "boolean" },
        "isExclusive": { "type": "boolean" },
        "isTrending": { "type": "boolean" },
        "releaseYear": { "type": "number" },
        "language": { "type": "string" },
        "ageRating": { "type": "string" },
        "authorPhotoUrl": { "type": "string" },
        "authorBio": { "type": "string" },
        "authorQuote": { "type": "string" },
        "shopArticles": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "author", "coverUrl"]
    },
    "Chapter": {
      "title": "Chapter",
      "description": "Chapitre ou épisode d'une série",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "seriesId": { "type": "string" },
        "chapterNumber": { "type": "number" },
        "title": { "type": "string" },
        "releaseDate": { "type": "string" },
        "isFree": { "type": "boolean" },
        "coinsRequired": { "type": "number" },
        "pages": { "type": "array" },
        "likesCount": { "type": "number" }
      },
      "required": ["id", "seriesId", "chapterNumber", "title"]
    },
    "Article": {
      "title": "Article",
      "description": "Article du magazine OZI Actu & Pop Culture",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "coverUrl": { "type": "string" },
        "category": { "type": "string" },
        "author": { "type": "string" },
        "publishedAt": { "type": "string" },
        "galleryImages": { "type": "array" },
        "readTimeMinutes": { "type": "number" }
      },
      "required": ["id", "title", "content"]
    },
    "Teaser": {
      "title": "Teaser",
      "description": "Bande-annonce vidéo d'une oeuvre",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "videoUrl": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "duration": { "type": "string" },
        "viewsCount": { "type": "number" }
      },
      "required": ["id", "title", "videoUrl"]
    },
    "PressRelease": {
      "title": "PressRelease",
      "description": "Communiqué de presse officiel OZI",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "content": { "type": "string" }
      },
      "required": ["id", "title", "content"]
    },
    "AppVersion": {
      "title": "AppVersion",
      "description": "Métadonnées de version APK et mise à jour",
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "buildNumber": { "type": "number" },
        "apkDownloadUrl": { "type": "string" },
        "apkSizeMb": { "type": "number" },
        "downloadsCount": { "type": "number" },
        "releaseDate": { "type": "string" },
        "changelog": { "type": "array" }
      },
      "required": ["version", "apkDownloadUrl"]
    },
    "CreatorSubmission": {
      "title": "CreatorSubmission",
      "description": "Candidature de créateur pour publier sur OZI",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "creatorName": { "type": "string" },
        "email": { "type": "string" },
        "projectTitle": { "type": "string" },
        "synopsis": { "type": "string" },
        "portfolioUrl": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["creatorName", "email", "projectTitle"]
    },
    "HomeHeroSlide": {
      "title": "HomeHeroSlide",
      "description": "Bannière vedette en tête de la page d'accueil",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "imageUrl": { "type": "string" },
        "logoUrl": { "type": "string" },
        "logoHeight": { "type": "number" },
        "formatStatus": { "type": "string" },
        "synopsis": { "type": "string" },
        "buttonText": { "type": "string" },
        "seriesId": { "type": "string" },
        "chapterId": { "type": "string" },
        "active": { "type": "boolean" },
        "order": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "imageUrl"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil lecteur authentifié OZI",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string" },
        "bio": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Artist": {
      "title": "Artist",
      "description": "Artiste ou illustrateur officiel OZI",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "photoUrl": { "type": "string" },
        "country": { "type": "string" },
        "bio": { "type": "string" },
        "specialties": { "type": "array" }
      },
      "required": ["id", "name", "photoUrl"]
    },
    "Artbook": {
      "title": "Artbook",
      "description": "Recueil d'art, artbook ou carnet de croquis",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "artistId": { "type": "string" },
        "artistName": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "coverUrl": { "type": "string" },
        "previewImages": { "type": "array" },
        "price": { "type": "number" },
        "isFree": { "type": "boolean" },
        "pageCount": { "type": "number" }
      },
      "required": ["id", "artistName", "title", "coverUrl"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Abonnement Premium individuel par œuvre (accès 30 jours via Paystack)",
      "type": "object",
      "properties": {
        "subscriptionId": { "type": "string" },
        "uid": { "type": "string" },
        "workId": { "type": "string" },
        "startDate": { "type": "string" },
        "expirationDate": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "expired", "pending", "failed"] },
        "paystackReference": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "customerEmail": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["subscriptionId", "uid", "workId", "startDate", "expirationDate", "status"]
    },
    "Review": {
      "title": "Review",
      "description": "Avis, note et commentaire de lecteur sur une oeuvre ou un chapitre",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "seriesId": { "type": "string" },
        "chapterId": { "type": "string" },
        "chapterNumber": { "type": "number" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhotoURL": { "type": "string" },
        "userRole": { "type": "string" },
        "rating": { "type": "number" },
        "commentText": { "type": "string" },
        "likesCount": { "type": "number" },
        "likedBy": { "type": "array" },
        "isSpoiler": { "type": "boolean" },
        "hasSubscribed": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "seriesId", "userId", "userName", "rating", "commentText"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Profils individuels des lecteurs et utilisateurs"
    },
    "/artists/{artistId}": {
      "schema": "Artist",
      "description": "Fiches artistes et concept artists"
    },
    "/artbooks/{artbookId}": {
      "schema": "Artbook",
      "description": "Recueils et artbooks avec prévisualisations"
    },
    "/artbook_downloads/{downloadId}": {
      "description": "Enregistrements des téléchargements d'artbooks gratuits"
    },
    "/artbook_purchases/{purchaseId}": {
      "description": "Commandes et transactions d'artbooks payants"
    },
    "/hero_slides/{slideId}": {
      "schema": "HomeHeroSlide",
      "description": "Bannières d'accueil visibles sur le site et toutes les plateformes"
    },
    "/series/{seriesId}": {
      "schema": "Series",
      "description": "Catalogue public des séries et webtoons"
    },
    "/series/{seriesId}/chapters/{chapterId}": {
      "schema": "Chapter",
      "description": "Chapitres et planches d'une série"
    },
    "/articles/{articleId}": {
      "schema": "Article",
      "description": "Articles du magazine OZI"
    },
    "/teasers/{teaserId}": {
      "schema": "Teaser",
      "description": "Teasers vidéos et trailers"
    },
    "/press_releases/{pressId}": {
      "schema": "PressRelease",
      "description": "Communiqués de presse"
    },
    "/config/{configId}": {
      "schema": "AppVersion",
      "description": "Configuration globale de l'app et version APK"
    },
    "/creator_submissions/{submissionId}": {
      "schema": "CreatorSubmission",
      "description": "Projets soumis par les auteurs et dessinateurs"
    },
    "/subscriptions/{subscriptionId}": {
      "schema": "Subscription",
      "description": "Abonnements Premium individuels par œuvre (accès 30 jours)"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Avis, commentaires et notations des lecteurs"
    },
    "/reported_comments/{reportId}": {
      "description": "Signalements de commentaires par les lecteurs pour modération"
    }
  }
}
