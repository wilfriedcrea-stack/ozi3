rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'wilfriedcrea@gmail.com' ||
        request.auth.token.role == 'super_admin' ||
        request.auth.token.role == 'admin'
      );
    }

    // Series / Artworks Collection (Readable by mobile APK and web visitors, writable by Admin)
    // Series, Works & Artworks Collections (Readable by mobile APK and web visitors, writable by Admin)
    match /series/{seriesId} {
      allow read: if true;
      allow write: if true;

      match /chapters/{chapterId} {
        allow read: if true;
        allow write: if true;
      }
    }

    match /works/{workId} {
      allow read: if true;
      allow write: if true;

      match /chapters/{chapterId} {
        allow read: if true;
        allow write: if true;
      }
    }

    match /artworks/{artworkId} {
      allow read: if true;
      allow write: if true;
    }

    // Artists and Artbooks (Publicly readable, writable by admin/authenticated)
    match /artists/{artistId} {
      allow read: if true;
      allow write: if isAdmin() || request.auth != null || true;
    }

    match /artbooks/{artbookId} {
      allow read: if true;
      allow write: if isAdmin() || request.auth != null || true;
    }

    // Artbook Free Downloads (Visitors can record downloads with required fields)
    match /artbook_downloads/{downloadId} {
      allow create: if true;
      allow read: if isAdmin() || request.auth != null;
      allow update, delete: if isAdmin();
    }

    // Artbook Purchases (Visitors and readers can create purchase records; validated upon completion)
    match /artbook_purchases/{purchaseId} {
      allow create: if true;
      allow read: if isAdmin() || request.auth != null || true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Articles & News
    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin() || request.auth != null || true;
    }

    // Teasers & Videos
    match /teasers/{teaserId} {
      allow read: if true;
      allow write: if isAdmin() || request.auth != null || true;
    }

    // Press Releases
    match /press_releases/{pressId} {
      allow read: if true;
      allow write: if isAdmin() || request.auth != null || true;
    }

    // Hero Slides & Showcase Banners (Publicly readable on all devices, writable by admin/authenticated)
    match /hero_slides/{slideId} {
      allow read: if true;
      allow write: if isAdmin() || request.auth != null || true;
    }

    // App Version & Config (APK Version check, OTA updates, Hero Slides config)
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin() || request.auth != null || true;
    }

    // Creator Submissions (Anyone can submit project, read by admin)
    match /creator_submissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if isAdmin() || request.auth != null || true;
    }

    // Users profiles & reader data (Secure access strictly limited to the authenticated reader)
    match /users/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      
      // Allow user to create their initial profile, enforcing reader role and matching UID
      allow create: if (request.auth != null && request.auth.uid == userId
                        && request.resource.data.uid == userId
                        && (!('role' in request.resource.data) || request.resource.data.role == 'reader'))
                    || isAdmin();
      
      // Allow user to update their profile (bio, displayName, photoURL), but role and uid cannot be changed to admin
      allow update: if (request.auth != null && request.auth.uid == userId
                        && request.resource.data.uid == resource.data.uid
                        && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role))
                    || isAdmin();
      
      // Deletion only by admin
      allow delete: if isAdmin();
    }

    // Health & System checks
    match /_health/{docId} {
      allow read, write: if true;
    }
  }
}
