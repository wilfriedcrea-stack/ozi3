rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // FONCTIONS D'AIDE ET DÉTECTION ADMINISTRATEUR SÉCURISÉE
    // =========================================================================
    
    // Vérifie si la requête provient de l'administrateur légitime de la plateforme.
    // L'administrateur est authentifié soit par son e-mail officiel (wilfriedcrea@gmail.com),
    // soit par un Custom Claim d'administration (super_admin ou admin).
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'wilfriedcrea@gmail.com' ||
        (request.auth.token.keys().hasAny(['role']) && 
         (request.auth.token.role == 'super_admin' || request.auth.token.role == 'admin'))
      );
    }

    // Vérifie si l'utilisateur est authentifié avec Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Vérifie si le compte authentifié est administrateur / modérateur en base ou wilfriedcrea@gmail.com
    function isAdminOrStaffUser() {
      return isAdmin() || (
        isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'admin', 'moderator']
      );
    }

    // =========================================================================
    // 1. SÉRIES, ŒUVRES & CHAPITRES (CATALOGUE OFFICIEL)
    // Protection ÉTAPE 2 : Interdiction totale d'écriture aux lecteurs.
    // Les lecteurs peuvent uniquement lire le catalogue.
    // Création, modification, suppression, métadonnées, prix et publication
    // sont strictement réservées à l'administrateur.
    // =========================================================================
    
    match /series/{seriesId} {
      allow read: if true;
      allow write: if isAdmin();

      // Chapitres et planches de chaque série
      match /chapters/{chapterId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Collections miroirs historiques ou multi-plateformes
    match /works/{workId} {
      allow read: if true;
      allow write: if isAdmin();

      match /chapters/{chapterId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /artworks/{artworkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 2. ARTISTES, ARTBOOKS & MONÉTISATION ASSOCIÉE
    // Protection ÉTAPE 2 & 3 : Les prix, fiches artistes, fichiers et aperçus
    // ne peuvent être modifiés que par l'administrateur.
    // =========================================================================
    
    match /artists/{artistId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /artbooks/{artbookId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Enregistrement des téléchargements gratuits (Lead Capture)
    match /artbook_downloads/{downloadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Commandes et transactions d'artbooks payants (Protection anti-fraude)
    // Aucun lecteur ne peut s'auto-attribuer 'downloadAuthorized: true' ou modifier le statut
    match /artbook_purchases/{purchaseId} {
      allow create: if true;
      allow read: if isAdmin() || (
        isAuthenticated() && (
          request.auth.uid == resource.data.userId || 
          request.auth.token.email == resource.data.customerEmail
        )
      );
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 3. ACTUALITÉS, TEASERS, PRESSE & BANNIÈRES
    // =========================================================================
    
    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /teasers/{teaserId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /press_releases/{pressId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hero_slides/{slideId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 4. CONFIGURATION DU SYSTÈME, SÉCURITÉ & TARIFICATION
    // Protection ÉTAPE 3 : Tarifs coins, pourcentage créateurs, secrets admin
    // =========================================================================
    
    match /config/{configId} {
      // Les données admin_security (empreintes de sécurité) ne sont jamais lisibles par les lecteurs
      allow read: if configId != 'admin_security' || isAdmin();
      allow write: if isAdmin();
    }

    // =========================================================================
    // 5. CANDIDATURES ET SOUMISSIONS DES CRÉATEURS
    // =========================================================================
    
    match /creator_submissions/{submissionId} {
      // Tout créateur peut soumettre sa candidature
      allow create: if true;
      // Consultation et modération réservées à l'administrateur
      allow read, update, delete: if isAdmin();
    }

    // =========================================================================
    // 6. PROFILS DES LECTEURS (users/{userId})
    // Protection ÉTAPE 4 :
    // - Chaque lecteur accède strictement à ses propres données.
    // - Interdiction de s'attribuer le rôle admin ou changer de rôle.
    // - Interdiction de modifier les champs de monétisation ou d'abonnement (isVip, vipExpiresAt, coinsBalance, isBanned).
    // =========================================================================
    
    match /users/{userId} {
      // Lecture : propriétaire authentifié ou administrateur
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);

      // Création de profil lecteur : à l'inscription initiale
      allow create: if isAdmin() || (
        isAuthenticated() && request.auth.uid == userId
        && request.resource.data.uid == userId
        && (!('role' in request.resource.data) || request.resource.data.role == 'reader')
        && (!('isVip' in request.resource.data) || request.resource.data.isVip == false)
        && (!('coinsBalance' in request.resource.data) || request.resource.data.coinsBalance == 0)
        && (!('isBanned' in request.resource.data) || request.resource.data.isBanned == false)
      );

      // Mise à jour de profil : seuls les champs personnels bénins sont modifiables par le lecteur
      // (displayName, bio, photoURL, updatedAt).
      // Les clés sensibles ci-dessous sont protégées contre toute modification par le client :
      allow update: if isAdmin() || (
        isAuthenticated() && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'uid', 'email', 'isVip', 'vipExpiresAt', 'coinsBalance', 'isBanned'
        ])
      );

      // Suppression de compte : réservée à l'administrateur
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 7. ABONNEMENTS PREMIUM PAR ŒUVRE (ACCÈS 30 JOURS PAYSTACK)
    // - Un lecteur ne peut lire que ses propres abonnements.
    // - Aucun lecteur ne peut créer, modifier ou supprimer un abonnement directement.
    //   L'activation et la gestion des abonnements sont gérées par le serveur ou l'administrateur.
    // =========================================================================
    
    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.uid);
      allow write: if isAdmin();
    }

    // Transactions et achats de packs de Coins Paystack
    match /coin_transactions/{txId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.uid);
      allow write: if isAdmin();
    }

    // =========================================================================
    // 8. DIAGNOSTIC SANTÉ SYSTÈME
    // =========================================================================
    
    match /_health/{docId} {
      allow read, write: if true;
    }

    // =========================================================================
    // 9. ESPACE COMMENTAIRES & NOTATIONS DES LECTEURS (REVIEWS)
    // - Lecture publique pour tous les visiteurs et lecteurs.
    // - Création réservée aux lecteurs authentifiés (userId correspondant au UID auth).
    // - Mise à jour par l'auteur ou mise à jour restreinte des likes/likedBy par tout utilisateur authentifié.
    // - Suppression par l'auteur ou l'administrateur.
    // =========================================================================

    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;

      allow update: if isAdmin() || (
        isAuthenticated() && (
          // L'auteur peut modifier son avis/note
          request.auth.uid == resource.data.userId ||
          // Ou un autre lecteur peut liker/unliker (seuls likesCount et likedBy affectés)
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedBy'])
        )
      );

      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.userId);
    }

    // =========================================================================
    // 10. SIGNALEMENTS DES COMMENTAIRES POUR MODÉRATION
    // - Tout lecteur connecté peut signaler un commentaire indésirable ou offensant.
    // - Seul l'administrateur peut consulter et traiter les signalements.
    // =========================================================================

    match /reported_comments/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // =========================================================================
    // 11. COMMENTAIRES & NOTES (5/5) SUR LES ARTBOOKS
    // =========================================================================

    function isValidReviewId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidArtbookReview(data) {
      return data.keys().hasAll([
          'id', 'artbookId', 'userId', 'userName', 'rating', 'commentText', 'likesCount', 'likedBy', 'createdAt', 'status'
        ])
        && data.keys().hasOnly([
          'id', 'artbookId', 'artbookTitle', 'userId', 'userName', 'userAvatar', 'rating', 'commentText', 'likesCount', 'likedBy', 'createdAt', 'updatedAt', 'status'
        ])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.artbookId is string && data.artbookId.size() > 0 && data.artbookId.size() <= 128
        && (!('artbookTitle' in data) || (data.artbookTitle is string && data.artbookTitle.size() <= 200))
        && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.userName is string && data.userName.size() > 0 && data.userName.size() <= 100
        && (!('userAvatar' in data) || (data.userAvatar is string && data.userAvatar.size() <= 1000))
        && data.rating is number && data.rating >= 0 && data.rating <= 5
        && data.commentText is string && data.commentText.size() >= 1 && data.commentText.size() <= 2000
        && data.likesCount is int && data.likesCount >= 0
        && data.likedBy is list && data.likedBy.size() <= 500
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64))
        && data.status in ['approved', 'pending', 'hidden'];
    }

    match /artbook_reviews/{reviewId} {
      allow read: if true;

      allow create: if isAuthenticated()
        && isValidReviewId(reviewId)
        && isValidArtbookReview(request.resource.data)
        && request.resource.data.id == reviewId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.likesCount == 0
        && request.resource.data.likedBy.size() == 0
        && request.resource.data.status == 'approved';

      allow update: if isAdmin() || (
        isAuthenticated()
        && isValidReviewId(reviewId)
        && isValidArtbookReview(request.resource.data)
        && request.resource.data.id == resource.data.id
        && request.resource.data.artbookId == resource.data.artbookId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (request.auth.uid == resource.data.userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'commentText', 'updatedAt']))
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedBy']))
        )
      );

      allow delete: if isAdmin() || (
        isAuthenticated()
        && isValidReviewId(reviewId)
        && request.auth.uid == resource.data.userId
      );
    }

    // =========================================================================
    // 12. SALON DE DISCUSSION PUBLIC TEMPS RÉEL (STYLE CHATANGO)
    // - Lecture et écriture ouvertes à tous (membres connectés & visiteurs).
    // - Anti-usurpation : les visiteurs ne peuvent ni usurper un userId ni définir
    //   de photo personnalisée (icône par défaut uniquement).
    // - Suppression réservée à l'auteur authentifié ou à l'administrateur.
    // =========================================================================

    function isValidMessageId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidReplyRef(reply) {
      return reply is map
        && reply.keys().hasAll(['id', 'authorName', 'excerpt'])
        && reply.keys().hasOnly(['id', 'authorName', 'excerpt'])
        && reply.id is string && reply.id.size() > 0 && reply.id.size() <= 128
        && reply.authorName is string && reply.authorName.size() > 0 && reply.authorName.size() <= 40
        && reply.excerpt is string && reply.excerpt.size() <= 160;
    }

    function isValidDiscussionMessage(data) {
      return data.keys().hasAll([
          'id', 'text', 'authorName', 'authorPhotoURL', 'userId', 'isGuest', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'text', 'authorName', 'authorPhotoURL', 'userId', 'guestSessionId', 'isGuest', 'authorIsAdmin', 'replyTo', 'createdAt'
        ])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 1000
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 40
        && data.authorPhotoURL is string && data.authorPhotoURL.size() <= 120000
        && data.isGuest is bool
        && (!('authorIsAdmin' in data) || data.authorIsAdmin is bool)
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!('guestSessionId' in data) || (data.guestSessionId is string && data.guestSessionId.size() <= 64))
        && (!('replyTo' in data) || data.replyTo == null || isValidReplyRef(data.replyTo))
        && (
          (data.isGuest == false && isAuthenticated() && data.userId is string && data.userId == request.auth.uid)
          ||
          (data.isGuest == true && data.userId == null && data.authorPhotoURL == '')
        );
    }

    match /discussion_messages/{messageId} {
      allow read: if true;

      allow create: if isValidMessageId(messageId)
        && isValidDiscussionMessage(request.resource.data)
        && request.resource.data.id == messageId
        && (
          !('authorIsAdmin' in request.resource.data)
          || request.resource.data.authorIsAdmin == false
          || (request.resource.data.isGuest == false && isAdminOrStaffUser())
        );

      allow update: if isAdmin();

      allow delete: if isAdmin() || (
        isAuthenticated()
        && isValidMessageId(messageId)
        && resource.data.isGuest == false
        && resource.data.userId == request.auth.uid
      );
    }

    // =========================================================================
    // 13. GALERIE DES CRÉATIONS COMMUNAUTAIRES (#galerie)
    // - Lecture ouverte à tous.
    // - Ajout d'images strictement réservé aux membres authentifiés (avec compte).
    // - Seuls les fichiers/URLs image valides sont acceptés.
    // - Tout visiteur ou membre peut liker/retirer son like (+1 / -1 atomique).
    // - Suppression réservée à l'auteur ou à l'administrateur.
    // =========================================================================

    function isValidCreationId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidGalleryImageUrl(url) {
      return url is string
        && url.size() >= 10
        && url.size() <= 900000
        && url.matches('^(https://|data:image/(webp|png|jpeg|jpg|gif);base64,).*');
    }

    function isValidGalleryCreation(data) {
      return data.keys().hasAll([
          'id', 'title', 'imageUrl', 'authorId', 'authorName', 'authorPhotoURL', 'likesCount', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'imageUrl', 'storagePath', 'authorId', 'authorName', 'authorPhotoURL', 'authorIsAdmin', 'likesCount', 'createdAt'
        ])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.title is string && data.title.size() <= 80
        && isValidGalleryImageUrl(data.imageUrl)
        && (!('storagePath' in data) || (data.storagePath is string && data.storagePath.size() <= 256))
        && data.authorId is string && data.authorId.size() > 0 && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 40
        && data.authorPhotoURL is string && data.authorPhotoURL.size() <= 120000
        && (!('authorIsAdmin' in data) || data.authorIsAdmin is bool)
        && data.likesCount is int && data.likesCount >= 0
        && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64;
    }

    function isValidGalleryLike(data) {
      return data.keys().hasAll(['id', 'creationId', 'userId', 'createdAt'])
        && data.keys().hasOnly(['id', 'creationId', 'userId', 'createdAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.creationId is string && data.creationId.size() > 0 && data.creationId.size() <= 128
        && (data.userId == null || (data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128))
        && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64;
    }

    match /gallery_creations/{creationId} {
      allow read: if true;

      allow create: if isAuthenticated()
        && isValidCreationId(creationId)
        && isValidGalleryCreation(request.resource.data)
        && request.resource.data.id == creationId
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.likesCount == 0
        && (
          !('authorIsAdmin' in request.resource.data)
          || request.resource.data.authorIsAdmin == false
          || isAdminOrStaffUser()
        );

      allow update: if isAdmin() || (
        isValidCreationId(creationId)
        && isValidGalleryCreation(request.resource.data)
        && request.resource.data.id == resource.data.id
        && request.resource.data.imageUrl == resource.data.imageUrl
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.authorPhotoURL == resource.data.authorPhotoURL
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (
            request.resource.data.title == resource.data.title
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])
            && (
              request.resource.data.likesCount == resource.data.likesCount + 1
              || (request.resource.data.likesCount >= 0 && request.resource.data.likesCount == resource.data.likesCount - 1)
            )
          )
          ||
          (
            isAuthenticated()
            && request.auth.uid == resource.data.authorId
            && request.resource.data.likesCount == resource.data.likesCount
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title'])
          )
        )
      );

      allow delete: if isAdmin() || (
        isAuthenticated()
        && isValidCreationId(creationId)
        && resource.data.authorId == request.auth.uid
      );

      match /likes/{likerId} {
        allow get: if isValidCreationId(creationId) && isValidCreationId(likerId);

        allow create: if isValidCreationId(creationId)
          && isValidCreationId(likerId)
          && isValidGalleryLike(request.resource.data)
          && request.resource.data.id == likerId
          && request.resource.data.creationId == creationId
          && exists(/databases/$(database)/documents/gallery_creations/$(creationId))
          && (
            (isAuthenticated() && request.resource.data.userId == request.auth.uid)
            || (!isAuthenticated() && request.resource.data.userId == null)
          );

        allow delete: if isAdmin() || (
          isValidCreationId(creationId)
          && isValidCreationId(likerId)
          && (
            (resource.data.userId != null && isAuthenticated() && resource.data.userId == request.auth.uid)
            || resource.data.userId == null
          )
        );
      }
    }
  }
}
